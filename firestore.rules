rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isEasyLesson(lessonId) {
      return lessonId in ['what-is-ai', 'ai-history', 'choose-your-model', 'use-ai-well'];
    }

    function isMediumLesson(lessonId) {
      return lessonId in [
        'llms-and-models', 'popular-llms', 'install-gui', 'install-cli',
        'prompt-anatomy', 'context-constraints', 'examples-iteration', 'verify-ai-output',
        'skills-understand', 'skills-create', 'skills-review',
        'instructions-understand', 'instructions-write', 'instructions-scope',
        'extensions-understand', 'extensions-connect', 'extensions-safety'
      ] || lessonId.matches('^(coding|research|automation)-[a-z-]+-[1-4]$');
    }

    function validCompletion(lessonId, data) {
      return data.keys().hasOnly(['lessonId', 'xp', 'gems', 'quizScore', 'completedAt'])
        && data.lessonId == lessonId
        && data.quizScore == 1
        && data.completedAt == request.time
        && (
          (isEasyLesson(lessonId) && data.xp == 50 && data.gems == 10)
          || (isMediumLesson(lessonId) && data.xp == 75 && data.gems == 15)
        );
    }

    match /users/{uid} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'xp', 'gems', 'level', 'rank',
          'completedCount', 'chosenModel', 'focusTrack', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.xp == 0
        && request.resource.data.gems == 0
        && request.resource.data.level == 1
        && request.resource.data.rank == 'Bronze I'
        && request.resource.data.completedCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'chosenModel', 'focusTrack', 'updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['chosenModel'])
          || request.resource.data.chosenModel in ['chatgpt', 'claude', 'gemini', 'llama-local', 'deepseek'])
        && (!request.resource.data.keys().hasAny(['focusTrack'])
          || request.resource.data.focusTrack in ['coding', 'research', 'automation'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /completedLessons/{lessonId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && !exists(/databases/$(database)/documents/users/$(uid)/completedLessons/$(lessonId))
          && validCompletion(lessonId, request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
